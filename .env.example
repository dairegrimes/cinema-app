POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=cinema
DATABASE_URL=postgresql://user:password@postgres:5432/cinema

# Public base URL of the backend API, used for confirm/unsubscribe links in emails
PUBLIC_API_URL=http://localhost:8000

# Origins allowed to call the API (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Email sender. Set RESEND_API_KEY to use Resend, or SMTP_* to use SMTP.
# If neither is set, emails are logged to the console (good for local dev).
EMAIL_FROM=Cinema Alerts <onboarding@resend.dev>
# RESEND_API_KEY=re_xxxxxxxx
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_USE_TLS=true
